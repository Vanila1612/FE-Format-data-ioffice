NODE_ENV=production

# MongoDB credentials used by docker-compose.prod.yml.
# Keep the password URL-safe (letters, numbers, dash, underscore, dot) or URL-encode
# special characters before placing it in DATABASE_URL-like values.
MONGO_INITDB_DATABASE=ioffice
MONGO_INITDB_ROOT_USERNAME=ioffice
MONGO_INITDB_ROOT_PASSWORD=change_this_strong_password

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
CORS_ORIGIN=http://YOUR_SERVER_IP:5173

MAX_UPLOAD_SIZE_MB=50
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_DISPLAY_NAME=System Admin

# Leave empty to disable the in-app assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_MAX_STEPS=6

REDIS_URL=redis://redis:6379
WORKER_ONLY=false
IMPORT_CHUNK_SIZE=500
