NODE_ENV=development
PORT=3001

DATABASE_URL=mongodb://ioffice:ioffice@localhost:27018/ioffice?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_INITDB_DATABASE=ioffice
MONGO_INITDB_ROOT_USERNAME=ioffice
MONGO_INITDB_ROOT_PASSWORD=ioffice

JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=../storage/uploads
EXPORT_DIR=../storage/exports
SNAPSHOT_DIR=../storage/snapshots
MAX_UPLOAD_SIZE_MB=50

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=System Admin

# OpenAI integration for the in-app assistant.
# Generate one at https://platform.openai.com/api-keys
# Leave OPENAI_API_KEY empty to disable the /api/ai routes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_STEPS=6
