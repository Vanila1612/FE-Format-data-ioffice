{
  "name": "ioffice-web-application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @ioffice/backend dev\" \"pnpm --filter @ioffice/frontend dev\"",
    "build": "pnpm --filter @ioffice/backend build && pnpm --filter @ioffice/frontend build",
    "start": "pnpm --filter @ioffice/backend start",
    "test": "pnpm --filter @ioffice/backend test && pnpm --filter @ioffice/frontend test",
    "lint": "pnpm --filter @ioffice/backend typecheck && pnpm --filter @ioffice/frontend typecheck",
    "prisma:generate": "pnpm --filter @ioffice/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @ioffice/backend prisma:migrate",
    "seed": "pnpm --filter @ioffice/backend seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  }
}
